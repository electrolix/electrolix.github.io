*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{
    background:#f5f7fb;
    color:#222;
    line-height:1.6;
}

a{
    text-decoration:none;
    color:inherit;
}

.container{
    width:min(1320px,92%);
    margin:auto;
}

/*======================
HEADER
======================*/

header{
    background:#fff;
    padding:70px 0;
    text-align:center;
    border-bottom:1px solid #ececec;
}

header h1{
    font-size:48px;
    font-weight:800;
    margin-bottom:18px;
}

header p{
    max-width:820px;
    margin:auto;
    font-size:18px;
    color:#666;
}

/*======================
SEARCH
======================*/

.search-area{
    margin-top:40px;
    display:flex;
    justify-content:center;
    gap:18px;
    flex-wrap:wrap;
}

.search-box{
    width:520px;
    max-width:100%;
    padding:17px 20px;
    font-size:16px;
    border:1px solid #ddd;
    border-radius:12px;
    outline:none;
    transition:.3s;
}

.search-box:focus{
    border-color:#0057ff;
    box-shadow:0 0 0 4px rgba(0,87,255,.12);
}

select{
    padding:17px;
    font-size:15px;
    border-radius:12px;
    border:1px solid #ddd;
    cursor:pointer;
    background:#fff;
}

/*======================
GRID
======================*/

.grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(380px,380px));
    justify-content:center;
    gap:32px;
    padding:70px 0;
}

/*======================
CARD
======================*/

.card{
    width:100%;
    max-width:380px;
    background:#fff;
    border-radius:20px;
    overflow:hidden;
    border:1px solid #ececec;
    transition:.35s;
    display:flex;
    flex-direction:column;
}

.card:hover{
    transform:translateY(-8px);
    box-shadow:0 18px 45px rgba(0,0,0,.08);
}

/*======================
IMAGE
======================*/

.card-image{
    width:100%;
    height:240px;
    overflow:hidden;
    background:#f3f5fa;
}

.card-image img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:.4s;
}

.card:hover .card-image img{
    transform:scale(1.05);
}

/*======================
CONTENT
======================*/

.content{
    padding:26px;
    display:flex;
    flex-direction:column;
    flex:1;
}

.badge{
    display:inline-block;
    padding:8px 16px;
    background:#eef4ff;
    color:#0057ff;
    font-size:13px;
    font-weight:700;
    border-radius:50px;
    margin-bottom:16px;
    width:fit-content;
}

.card h3{
    font-size:24px;
    font-weight:700;
    margin-bottom:12px;
}

.card p{
    font-size:15px;
    color:#666;
    margin-bottom:22px;
}

.btn{
    display:inline-flex;
    align-items:center;
    justify-content:center;
    padding:14px 22px;
    background:#2563eb;
    color:#fff;
    border-radius:10px;
    font-weight:600;
    transition:.3s;
    margin-top:auto;
    width:fit-content;
}

.btn:hover{
    background:#003fc0;
}

footer{
    padding:60px 0;
    text-align:center;
    background:#fff;
    border-top:1px solid #ececec;
    color:#666;
}

/*======================
TABLET
======================*/

@media (max-width:1200px){

    .grid{
        grid-template-columns:repeat(auto-fill,minmax(340px,340px));
    }

}

/*======================
MOBILE
======================*/

@media (max-width:768px){

    header{
        padding:50px 20px;
    }

    header h1{
        font-size:34px;
    }

    header p{
        font-size:16px;
    }

    .search-area{
        flex-direction:column;
        align-items:center;
    }

    .search-box,
    select{
        width:100%;
        max-width:100%;
    }

    .grid{
        grid-template-columns:1fr;
        justify-content:stretch;
        gap:20px;
        padding:30px 15px;
    }

    .card{
        max-width:100%;
    }

    .card-image{
        height:210px;
    }

    .content{
        padding:20px;
    }

    .card h3{
        font-size:22px;
    }

    .card p{
        font-size:14px;
    }

    .btn{
        width:100%;
        justify-content:center;
    }

    body{
        overflow-x:hidden;
    }

}

